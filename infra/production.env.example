# Reference only. Inject real values through a secret manager or deployment environment.
# API_IMAGE and WEB_IMAGE must be immutable registry references containing @sha256:...
API_IMAGE=ghcr.io/example/curriculum-navigator-api:0.1.0@sha256:REPLACE_WITH_RELEASE_DIGEST
WEB_IMAGE=ghcr.io/example/curriculum-navigator-web:0.1.0@sha256:REPLACE_WITH_RELEASE_DIGEST
POSTGRES_DB=curriculum
POSTGRES_USER=curriculum_owner
POSTGRES_PASSWORD=REPLACE_WITH_SECRET_MANAGER_VALUE
RUNTIME_DATABASE_URL=postgresql://curriculum_runtime:REPLACE_WITH_URL_ENCODED_RUNTIME_PASSWORD@postgres:5432/curriculum
MIGRATION_DATABASE_URL=postgresql://curriculum_migrator:REPLACE_WITH_URL_ENCODED_MIGRATOR_PASSWORD@postgres:5432/curriculum
DJANGO_SECRET_KEY=REPLACE_WITH_64_PLUS_RANDOM_CHARACTERS
PRIVILEGED_MFA_REQUIRED=true
SENSITIVE_IDENTITY_READ_RATE_LIMIT_PER_MINUTE=30
ALLOWED_HOSTS=app.example.edu
APP_DOMAIN=app.example.edu
PUBLIC_APP_URL=https://app.example.edu
CSRF_TRUSTED_ORIGINS=https://app.example.edu
CORS_ALLOWED_ORIGINS=https://app.example.edu
TLS_EMAIL=ops@example.edu
OBSERVABILITY_METRICS_TOKEN=REPLACE_WITH_SECRET_MANAGER_VALUE
OTEL_EXPORTER_OTLP_ENDPOINT=
